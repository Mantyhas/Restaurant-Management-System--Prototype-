/* ===== BENDRAS FONAS ===== */
body {
    background: #f5e9d3; /* soft sand */
    font-family: "Segoe UI", Tahoma, sans-serif;
    margin: 0;
}

/* ===== HEADER ===== */
header {
    background: #6d5e4f; /* moss brown */
    padding: 15px;
    display: flex;
    justify-content: center;
}

nav a {
    color: white;
    margin: 0 15px;
    font-size: 18px;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

/* ===== BENDRI HTML MYGTUKAI (formose) ===== */
button {
    width: 100%;
    padding: 13px;
    background: #6d5e4f;
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 17px;
    cursor: pointer;
}

button:hover {
    background: #5b4f43;
}

/* ===== BENDRI CUSTOM MYGTUKAI (linkai ir pan.) ===== */
.btn {
    display: inline-block;
    padding: 8px 18px;
    border-radius: 8px;
    background: #6d5e4f; /* moss brown */
    color: #fff;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
}
.btn:hover {
    background: #5b4f43;
}

.btn-outline {
    background: #fff7ec;  /* light sand */
    color: #6d5e4f;
    border: 1px solid #6d5e4f;
}
.btn-outline:hover {
    background: #eaddc8;
}

.btn-active {
    box-shadow: 0 0 0 2px #c8b79f inset;
}

.btn-secondary {
    background: #4f4742;
}

/* ===== FORMOS BLOKAS (rezervacija, login ir pan.) ===== */
.form-box {
    background: white;
    width: 420px;
    margin: 40px auto;
    padding: 25px;
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
}

input,
select {
    width: 100%;
    padding: 14px;
    margin-top: 6px;
    margin-bottom: 20px;
    border-radius: 6px;
    border: 1px solid #bfb6a4;
    box-sizing: border-box;
}

/* ===== RESTORANŲ SĄRAŠAS (rezervacijos pasirinkime) ===== */
.restaurant-list {
    width: 380px;
    margin: 20px auto;
}

.restaurant-card {
    display: block;
    padding: 16px;
    margin-bottom: 15px;
    background: #6d5e4f;
    color: white;
    border-radius: 10px;
    text-align: center;
    font-size: 20px;
    text-decoration: none;
    transition: 0.2s ease;
}

.restaurant-card:hover {
    background: #5b4f43;
    transform: translateY(-3px);
}

/* ===== GRINDŲ PLANAS (SALĖ) ===== */
.floorplan {
    width: 780px;
    margin: 20px auto 40px;
    padding: 20px;
    background: #fff7ec;
    border: 4px solid #3f3027;
    border-radius: 8px;
}

/* Eilės staliukų */
.table-row {
    display: flex;
    justify-content: center;
    margin: 20px 0;
}

/* Staliukai – vizualas */
.table-item {
    width: 110px;
    height: 60px;
    margin: 10px;
    background: #d8c0a8;      /* light soft brown */
    border-radius: 50px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    color: #3f3027;
    font-weight: 600;
    border: 3px solid #b89b82;
}

/* Laisvas stalas */
.table-free {
    background: #e5caa7;
}

/* Užimtas stalas */
.table-busy {
    background: #c6c6c6;
    color: #555;
    pointer-events: none;
    border-color: #7a7a7a;
}

/* WC + Virtuvė blokai */
.blocks {
    margin-top: 40px;
    display: flex;
    justify-content: space-around;
}

.wc-block,
.kitchen-block {
    width: 160px;
    height: 90px;
    background: #d5ccb8;
    border: 3px solid #3f3027;
    border-radius: 6px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 700;
}

/* Įėjimo tekstas */
.entrance {
    margin-top: 10px;
    text-align: center;
    font-weight: 700;
    color: #3f3027;
}

/* Rezervacijos tekstai */
.reservation-success {
    text-align: center;
    color: green;
    font-size: 22px;
    margin: 20px 0 40px;
}

.no-restaurants {
    text-align: center;
    color: red;
    font-size: 18px;
    margin-top: 20px;
}

/* --- senesnis visibility style, šiuo metu beveik nenaudojamas, bet paliekam jei prireiks --- */
.vis-toggle {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: #555;
}
.vis-toggle input {
    margin-right: 4px;
}
.save-vis-btn {
    padding: 10px 18px;
    background: #6d5e4f;
    color: #fff;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 15px;
}
.save-vis-btn:hover {
    background: #5b4f43;
}

/* ===== MENIU VIRŠUS: restoranų ir redagavimo mygtukai ===== */
.menu-top-bar {
    max-width: 1000px;
    margin: 20px auto 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.menu-rest-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.menu-actions {
    display: flex;
    gap: 10px;
}

/* ===== MENIU KORTELĖS (3 stulpeliai) ===== */
.menu-wrapper {
    max-width: 1000px;
    margin: 15px auto 60px;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

.menu-section h3 {
    margin: 0 0 10px;
    font-size: 20px;
    color: #3f3027;
}

.menu-cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.menu-card {
    background: #fff7ec;
    border-radius: 10px;
    padding: 10px 14px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.menu-card-header {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    margin-bottom: 4px;
}

.dish-title {
    max-width: 70%;
}

.dish-price {
    color: #6d5e4f;
}

.dish-desc {
    margin: 0;
    font-size: 13px;
    color: #4a4a4a;
}

/* ===== MENIU REDAGAVIMO LENTELĖ VADYBININKUI ===== */
.menu-edit-wrapper {
    max-width: 1000px;
    margin: 20px auto 60px;
    background: #fffdf7;
    padding: 18px;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    font-size: 14px;
}

.menu-edit-table {
    width: 100%;
    border-collapse: collapse;
}

.menu-edit-table th,
.menu-edit-table td {
    border: 1px solid #d2c3aa;
    padding: 6px 8px;
}

.menu-edit-table th {
    background: #f1e3cd;
}
/* ===== RESTORANŲ TABAI MENIU PUSLAPYJE ===== */
.menu-rest-tabs {
    max-width: 800px;
    margin: 10px auto 15px;
    display: flex;
    justify-content: center;
    gap: 20px;
}

/* ===== 3 STULPELIŲ MENIU LENTELĖ ===== */
.menu-columns {
    max-width: 1000px;
    margin: 0 auto 50px;
    display: flex;
    border: 4px solid #8b6a3f;
    background: #f5e4b9;
}

.menu-column {
    flex: 1;
    border-left: 2px solid #8b6a3f;
    display: flex;
    flex-direction: column;
}
.menu-column:first-child {
    border-left: none;
}

.menu-col-header {
    background: #7a6b52;
    color: #fff;
    text-align: center;
    padding: 12px 5px;
    font-weight: 700;
    font-size: 19px;
}


.menu-col-body {
    flex: 1;
    padding: 12px 14px;
    background: #f9efc9;
    min-height: 200px;
    font-size: 16px;
}

.menu-col-footer {
    padding: 10px;
    text-align: center;
    border-top: 2px solid #8b6a3f;
    background: #f0e0b5;
}

/* Patiekalų sąrašas paprastam režimui */
.dish-list {
    list-style: none;
    margin: 0;
    padding: 0;
}
.dish-list li {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 16px;
}

/* Redagavimo režimo sąrašas */
.edit-dish-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
}
.edit-dish-list li {
    margin-bottom: 4px;
    font-size: 14px;
}

.edit-form-block {
    margin-bottom: 10px;
}

.btn-small {
    padding: 6px 12px;
    font-size: 13px;
    width: auto;
}
/* ===== PRADŽIOS PUSLAPIO HERO BLOKAS ===== */
.hero-container {
    max-width: 1100px;
    margin: 40px auto 60px;
    display: flex;
    gap: 40px;
    align-items: center;
    padding: 25px 30px;
    background: #fff7ec;
    border-radius: 14px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.12);
}

.hero-text {
    flex: 1.2;
}

.hero-title {
    margin: 0 0 12px;
    font-size: 36px;
    color: #6d5e4f; /* moss brown */
}

.hero-subtitle {
    margin: 0 0 20px;
    font-size: 16px;
    color: #3f3027;
    line-height: 1.5;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

/* didesni mygtukai pradžios puslapiui */
.btn-large {
    padding: 12px 24px;
    font-size: 16px;
}

/* paveiksliuko blokas */
.hero-image {
    flex: 1;
    text-align: right;
}

.hero-image img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    object-fit: cover;
}


