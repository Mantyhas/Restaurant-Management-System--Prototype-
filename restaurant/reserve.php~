/* Helper funkcijos rezervacijų statusui ir nuorodoms */
function status($table_num, $reservedTables) {
    return in_array($table_num, $reservedTables) ? "table-busy" : "table-free";
}
function link_for($table_num, $restaurant_id, $date, $time, $reservedTables) {
    if (in_array($table_num, $reservedTables)) return "";
    return "href='reserve.php?book=$table_num&restaurant=$restaurant_id&date=$date&time=$time'";
}

/* Patikrinimai */
$isRestSelected = isset($_GET['restaurant']);
